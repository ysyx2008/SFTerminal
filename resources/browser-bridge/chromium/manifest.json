{
  "manifest_version": 3,
  "name": "SailFish Browser Assistant",
  "description": "Connects your browser to SailFish Agent for tab and login reuse.",
  "version": "1.1.0",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SailFish Browser Assistant",
    "default_popup": "popup.html"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["safe-eval.js", "snapshot.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
