{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@shared/types": ["./shared/types/index.ts"],
      "@shared/*": ["./shared/*"],
      "@sailfish/shared-types": ["./packages/shared-types/src/index.ts"],
      "@sailfish/workbench-sdk": ["./packages/workbench-sdk/src/index.ts"],
      "@sailfish/workbench-assistant": ["./packages/workbench-assistant/src/index.ts"],
      "@sailfish/workbench-local": ["./packages/workbench-local/src/index.ts"],
      "@sailfish/workbench-ssh": ["./packages/workbench-ssh/src/index.ts"],
      "@sailfish/workbench-companion": ["./packages/workbench-companion/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "shared/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts"]
}
