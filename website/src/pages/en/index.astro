---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import HomeStory from '../../components/HomeStory.astro';
import Capabilities from '../../components/Capabilities.astro';
import Download from '../../components/Download.astro';
import Footer from '../../components/Footer.astro';
import LicenseSection from '../../components/LicenseSection.astro';

const lang = 'en';
---

<Layout title="SailFish - Your Private Desktop Secretary" lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <HomeStory lang={lang} />
    <Capabilities lang={lang} />
    <Download lang={lang} />
  </main>
  <LicenseSection lang={lang} />
  <Footer lang={lang} />
</Layout>
