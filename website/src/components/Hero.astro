---
import { useTranslations, type Lang } from '../i18n/utils';
import { defaultLanguage } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = defaultLanguage } = Astro.props;
const t = useTranslations(lang);
const heroImage = lang === 'zh' ? '/screenshot-welcome.jpg' : '/screenshot-welcome_en.jpg';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-brand fade-in">{t.hero.brand}</p>
      <h1 class="hero-title fade-in fade-in-delay-1">{t.hero.title}</h1>
      <p class="hero-subtitle fade-in fade-in-delay-2">{t.hero.subtitle}</p>
      <div class="hero-actions fade-in fade-in-delay-3">
        <a href="#download" class="btn btn-primary btn-lg">{t.hero.downloadBtn}</a>
        <a href="#task" class="btn btn-secondary btn-lg">{t.hero.learnBtn}</a>
      </div>
      <p class="hero-note fade-in fade-in-delay-3">{t.hero.apiNotice}</p>
    </div>

    <div class="hero-visual fade-in fade-in-delay-2">
      <img src={heroImage} alt={t.hero.imageAlt} width="1600" height="1000" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 120px 0 64px;
    background: var(--color-bg-primary);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .hero-brand {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .hero-title {
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--color-text-primary);
    max-width: 18em;
    margin-bottom: 16px;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 34em;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 14px;
  }

  .hero-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .hero-visual {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-secondary);
    box-shadow: var(--shadow-card);
  }

  .hero-visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 100px 0 48px;
    }
  }
</style>
