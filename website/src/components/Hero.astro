---
import { useTranslations, type Lang } from '../i18n/utils';
import { defaultLanguage } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = defaultLanguage } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-brand fade-in">{t.hero.brand}</p>
      <h1 class="hero-title fade-in fade-in-delay-1">{t.hero.title}</h1>
      <p class="hero-subtitle fade-in fade-in-delay-2">{t.hero.subtitle}</p>
      <div class="hero-actions fade-in fade-in-delay-3">
        <a href="#download" class="btn btn-primary btn-lg">{t.hero.downloadBtn}</a>
        <a href="#task" class="btn btn-secondary btn-lg">{t.hero.learnBtn}</a>
      </div>
      <p class="hero-note fade-in fade-in-delay-4">{t.hero.apiNotice}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    /* 必须满一屏：fixed header 不占文档流，减 72px 会让下一屏截图探进来 */
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 120px 0 96px;
    background: var(--color-bg-primary);
    box-sizing: border-box;
  }

  .hero-inner {
    width: 100%;
  }

  .hero-copy {
    max-width: 40rem;
    text-align: left;
  }

  .hero-brand {
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-text-primary);
    margin-bottom: 18px;
  }

  .hero-title {
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
    color: var(--color-text-primary);
    max-width: 16em;
    margin-bottom: 18px;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 30em;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  .hero-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 100svh;
      padding: 108px 0 80px;
      align-items: flex-end;
    }
  }
</style>
