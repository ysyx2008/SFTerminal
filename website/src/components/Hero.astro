---
import { useTranslations, type Lang } from '../i18n/utils';
import { defaultLanguage } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = defaultLanguage } = Astro.props;
const t = useTranslations(lang);
const heroImage = lang === 'zh' ? '/screenshot-welcome.jpg' : '/screenshot-welcome_en.jpg';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-brand fade-in">{t.hero.brand}</p>
      <h1 class="hero-title fade-in fade-in-delay-1">{t.hero.title}</h1>
      <p class="hero-subtitle fade-in fade-in-delay-2">{t.hero.subtitle}</p>
      <div class="hero-actions fade-in fade-in-delay-3">
        <a href="#download" class="btn btn-primary btn-lg">{t.hero.downloadBtn}</a>
        <a href="#task" class="btn btn-secondary btn-lg">{t.hero.learnBtn}</a>
      </div>
      <p class="hero-note fade-in fade-in-delay-4">{t.hero.apiNotice}</p>
    </div>

    <div class="hero-visual fade-in reveal-scale fade-in-delay-3">
      <img src={heroImage} alt={t.hero.imageAlt} width="1600" height="1000" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 128px 0 72px;
    background: var(--color-bg-primary);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 48px;
    text-align: left;
  }

  .hero-copy {
    max-width: 38rem;
  }

  .hero-brand {
    font-size: clamp(2.75rem, 6.5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
    color: var(--color-text-primary);
    margin-bottom: 14px;
  }

  .hero-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
    color: var(--color-text-primary);
    max-width: 16em;
    margin-bottom: 16px;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.7vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 34em;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 14px;
  }

  .hero-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .hero-visual {
    width: 100%;
    max-width: 960px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-secondary);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-border) 80%, transparent),
      0 24px 64px rgba(28, 25, 23, 0.08);
    transition:
      opacity var(--duration-reveal) var(--ease-out-soft),
      transform var(--duration-reveal) var(--ease-out-soft);
  }

  [data-theme="dark"] .hero-visual {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-border) 90%, transparent),
      0 28px 72px rgba(0, 0, 0, 0.45);
  }

  .hero-visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 108px 0 52px;
    }

    .hero-inner {
      gap: 36px;
    }
  }
</style>
